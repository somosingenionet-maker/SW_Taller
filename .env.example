# Copia este archivo a .env.local y rellena con tus claves de Supabase.
#
# Desarrollo LOCAL (tras `npx supabase start`):
#   VITE_SUPABASE_URL       -> http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY  -> la ANON_KEY que imprime el comando (o `supabase status`)
#
# PRODUCCIÓN (proyecto en supabase.com > Project Settings > API):
#   VITE_SUPABASE_URL       -> https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY  -> la clave "anon public"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
